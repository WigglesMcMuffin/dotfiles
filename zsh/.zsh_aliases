alias ..='cd ..'

# Take a screenshot
alias screenie='() { scrot ~/screencaps/$@.png }'

# colour greps
alias grep='() { $(whence -p grep) --color=auto $@ }'

# Show what rm is rm-ing
alias rm='rm -v'

zshaddhistory() { whence ${${(z)1}[1]} >| /dev/null || return 1 }
alias pac=yay
pacmatic="sudo --preserve-env=pacman_program /usr/bin/pacmatic"
